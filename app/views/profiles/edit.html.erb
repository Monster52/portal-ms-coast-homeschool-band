<h1>Edit Profile</h1>

<div class="card" style="max-width:480px">
  <%= form_with model: @user, url: profile_path, method: :patch, multipart: true do |f| %>
    <% if @user.errors.any? %>
      <ul class="error-list">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div style="margin-bottom:1.25rem">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "profile-avatar", alt: "Current picture" %>
        <p style="margin:0.5rem 0 0;font-size:0.85rem;color:#666">Upload a new image to replace it.</p>
      <% end %>
      <%= f.label :avatar, "Profile Picture" %>
      <%= f.file_field :avatar, accept: "image/*" %>
    </div>

    <div>
      <%= f.label :first_name %>
      <%= f.text_field :first_name %>
    </div>

    <div>
      <%= f.label :last_name %>
      <%= f.text_field :last_name %>
    </div>

    <div style="display:flex;gap:0.75rem;margin-top:1.25rem">
      <%= f.submit "Save", class: "btn" %>
      <%= link_to "Cancel", profile_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
