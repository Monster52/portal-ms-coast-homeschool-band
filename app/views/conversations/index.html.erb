<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
  <h1 style="margin:0">Messages</h1>
  <% if current_user.can_message? %>
    <%= link_to "New Message", new_conversation_path, class: "btn" %>
  <% end %>
</div>

<% if @conversations.any? %>
  <div class="card" style="padding:0">
    <% @conversations.each do |convo| %>
      <% other = convo.other_participant(current_user) %>
      <% next unless other %>
      <% unread = convo.unread_count_for(current_user) %>
      <%= link_to conversation_path(convo), style: "display:block;text-decoration:none;color:inherit" do %>
        <div style="display:flex;align-items:center;gap:0.9rem;padding:0.9rem 1.25rem;border-bottom:1px solid #f0f0f0;<%= 'background:#f8fafd' if unread > 0 %>">
          <% if other.avatar.attached? %>
            <%= image_tag other.avatar, class: "avatar-sm", alt: "" %>
          <% else %>
            <div class="avatar-sm" style="background:#dde3ea;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9rem;font-weight:600;color:#555;flex-shrink:0">
              <%= other.full_name.first.upcase %>
            </div>
          <% end %>
          <div style="flex:1;min-width:0">
            <div style="display:flex;justify-content:space-between;align-items:baseline">
              <strong style="font-size:0.95rem"><%= other.full_name %></strong>
              <% if convo.last_message %>
                <span style="font-size:0.78rem;color:#888;white-space:nowrap;margin-left:0.5rem">
                  <%= convo.last_message.created_at.to_fs(:short) %>
                </span>
              <% end %>
            </div>
            <% if convo.last_message %>
              <p style="margin:0.1rem 0 0;font-size:0.85rem;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                <% if convo.last_message.sender == current_user %>You: <% end %>
                <%= convo.last_message.body.truncate(80) %>
              </p>
            <% end %>
          </div>
          <% if unread > 0 %>
            <span class="nav-badge"><%= unread %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <p style="color:#888;margin:0">No messages yet.</p>
    <% if current_user.can_message? %>
      <%= link_to "Start a conversation", new_conversation_path %>
    <% end %>
  </div>
<% end %>
